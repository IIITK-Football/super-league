{
  "$comment": "Test groups. `paths` select a group to RUN when a changed file matches (* = within a segment, ** = across segments). `covers` is the source a group's tests really verify; `testPaths` are its test files. An active group must declare both. A group with \"status\": \"pending\" has no tests yet: it covers nothing, so changing a path that only pending groups map is rejected (see `node scripts/test-groups.mjs check`) until tests exist; `pendingFor` names the backlog item that adds them. Files that need no tests are listed by category, with a reason, in tests/gate-exemptions.json.",
  "groups": {
    "database": {
      "description": "Schema, migrations, seed, RLS policies (pgTAP against the local Supabase DB on 54322)",
      "owner": "backend",
      "requiresLocalDb": true,
      "paths": [
        "backend/supabase/**"
      ],
      "run": [
        {
          "cwd": ".",
          "cmd": [
            "bash",
            "scripts/local-db.sh",
            "test"
          ]
        }
      ],
      "covers": [
        "backend/supabase/migrations/**",
        "backend/supabase/seed.sql"
      ],
      "testPaths": [
        "backend/supabase/tests/**"
      ]
    },
    "config": {
      "description": "Environment examples and startup validation for frontend and backend; type check of the backend",
      "owner": "platform",
      "paths": [
        "**/.env.example",
        "backend/**/*.ts",
        "backend/app/**",
        "backend/instrumentation.ts",
        "backend/lib/env.ts",
        "backend/lib/supabase/**",
        "backend/middleware.ts",
        "backend/supabase/config.toml",
        "backend/tsconfig.json",
        "frontend/.dev.vars.example",
        "frontend/functions/**",
        "frontend/scripts/check-bundle.mjs",
        "frontend/src/lib/env.js",
        "frontend/src/lib/supabase.js"
      ],
      "run": [
        {
          "cwd": "backend",
          "cmd": [
            "pnpm",
            "exec",
            "vitest",
            "run",
            "tests/config"
          ]
        },
        {
          "cwd": "frontend",
          "cmd": [
            "pnpm",
            "exec",
            "vitest",
            "run",
            "src/lib"
          ]
        },
        {
          "cwd": "backend",
          "cmd": [
            "pnpm",
            "exec",
            "tsc",
            "--noEmit"
          ]
        }
      ],
      "covers": [
        "**/.env.example",
        "backend/lib/env.ts",
        "backend/instrumentation.ts",
        "frontend/src/lib/env.js",
        "frontend/src/lib/supabase.js",
        "backend/supabase/config.toml",
        "frontend/functions/**",
        "frontend/.dev.vars.example",
        "backend/lib/supabase/**",
        "backend/middleware.ts",
        "frontend/scripts/check-bundle.mjs"
      ],
      "testPaths": [
        "backend/tests/config/**",
        "frontend/src/lib/__tests__/**"
      ]
    },
    "tooling": {
      "description": "Repository scripts, test-group runner, commit hooks, workspace config",
      "owner": "platform",
      "paths": [
        ".claude/settings.json",
        ".githooks/**",
        ".github/workflows/**",
        ".gitmessage",
        ".nvmrc",
        ".pre-commit-config.yaml",
        "frontend/scripts/take-screenshots.js",
        "pnpm-workspace.yaml",
        "scripts/**",
        "tests/gate-baseline.json",
        "tests/gate-exemptions.json",
        "tests/groups.json"
      ],
      "run": [
        {
          "cwd": "backend",
          "cmd": [
            "pnpm",
            "exec",
            "vitest",
            "run",
            "tests/tooling"
          ]
        }
      ],
      "covers": [
        ".claude/settings.json",
        ".githooks/**",
        ".github/workflows/**",
        ".gitmessage",
        ".nvmrc",
        "frontend/scripts/take-screenshots.js",
        "pnpm-workspace.yaml",
        "scripts/**",
        "tests/gate-baseline.json",
        "tests/gate-exemptions.json",
        "tests/groups.json"
      ],
      "testPaths": [
        "backend/tests/tooling/**"
      ]
    },
    "auth-identity": {
      "description": "College email rule, password/Google same-user behavior, reset flow (unit + local Auth integration tests)",
      "owner": "backend",
      "requiresLocalDb": true,
      "paths": [
        "backend/lib/auth/**",
        "backend/tests/auth/**",
        "backend/app/api/auth/**",
        "backend/supabase/config.toml",
        "backend/supabase/migrations/*auth*",
        "frontend/src/lib/authApi.js",
        "frontend/src/lib/authRules.js",
        "frontend/src/lib/__tests__/auth*",
        "frontend/src/context/AuthContext.jsx",
        "frontend/src/pages/Login.jsx",
        "frontend/src/pages/ResetPassword.jsx",
        "frontend/src/components/PasswordSettings.jsx",
        "frontend/src/components/GlobalAuthRedirect.jsx",
        "frontend/src/pages/__tests__/**",
        "frontend/src/components/__tests__/**",
        "frontend/src/App.jsx",
        "docs/rollback/**",
        "frontend/src/components/TurnstileWidget.jsx",
        "frontend/src/pages/AdminLogin.jsx"
      ],
      "run": [
        {
          "cwd": "backend",
          "cmd": [
            "pnpm",
            "exec",
            "vitest",
            "run",
            "tests/auth"
          ]
        },
        {
          "cwd": "frontend",
          "cmd": [
            "pnpm",
            "exec",
            "vitest",
            "run",
            "src/lib/__tests__/authRules.test.js",
            "src/lib/__tests__/authApi.test.js",
            "src/lib/__tests__/authApi.captcha.test.js",
            "src/lib/__tests__/authApi.reauth.test.js",
            "src/pages/__tests__",
            "src/components/__tests__"
          ]
        }
      ],
      "covers": [
        "backend/lib/auth/**",
        "backend/app/api/auth/**",
        "backend/app/api/admin/team-registrations/**",
        "backend/supabase/migrations/*auth*",
        "frontend/src/lib/authApi.js",
        "frontend/src/lib/authRules.js",
        "frontend/src/context/AuthContext.jsx",
        "frontend/src/pages/Login.jsx",
        "frontend/src/pages/ResetPassword.jsx",
        "frontend/src/components/PasswordSettings.jsx",
        "frontend/src/components/GlobalAuthRedirect.jsx",
        "frontend/src/components/TurnstileWidget.jsx",
        "frontend/src/pages/AdminLogin.jsx"
      ],
      "testPaths": [
        "backend/tests/auth/**",
        "frontend/src/lib/__tests__/auth*",
        "frontend/src/pages/__tests__/**",
        "frontend/src/components/__tests__/**"
      ]
    },
    "divisions": {
      "description": "Division, season and section model: the dictator path and the season-scoped public and admin API routes against the local Auth and Data API, and the dictator dashboard flow (allowed and denied cases, hidden and archived records)",
      "owner": "backend",
      "requiresLocalDb": true,
      "paths": [
        "backend/tests/divisions/**",
        "backend/supabase/migrations/*division*",
        "backend/supabase/migrations/*current_season*",
        "frontend/src/components/admin/ManageDivisions.jsx",
        "frontend/src/components/admin/__tests__/ManageDivisions.local.test.jsx",
        "backend/lib/scope.ts",
        "backend/lib/errorHandler.ts",
        "backend/app/api/home/dashboard/**",
        "backend/app/api/standings/**",
        "backend/app/api/teams/**",
        "backend/app/api/leaderboard/**",
        "backend/app/api/legends/**",
        "backend/app/api/predictions/leaderboard/**",
        "backend/app/api/admin/matches/route.ts",
        "backend/app/api/admin/teams/**",
        "backend/app/api/admin/stats/**",
        "backend/app/api/captain/team-branding/**",
        "backend/app/api/polls/**",
        "backend/supabase/migrations/*flairs*",
        "backend/supabase/migrations/*legacy*",
        "backend/app/api/schedule/**",
        "backend/app/api/predictions/history/**",
        "backend/app/api/players/**",
        "backend/app/api/admin/predictions/grade/**",
        "backend/app/api/admin/predictions/regrade-all/**",
        "backend/supabase/migrations/*fantasy*"
      ],
      "run": [
        {
          "cwd": "backend",
          "cmd": [
            "pnpm",
            "exec",
            "vitest",
            "run",
            "--no-file-parallelism",
            "tests/divisions"
          ]
        },
        {
          "cwd": "frontend",
          "cmd": [
            "env",
            "SL_LOCAL_SUPABASE=1",
            "pnpm",
            "exec",
            "vitest",
            "run",
            "src/components/admin/__tests__/ManageDivisions.local.test.jsx"
          ]
        }
      ],
      "covers": [
        "backend/supabase/migrations/*division*",
        "backend/supabase/migrations/*current_season*",
        "frontend/src/components/admin/ManageDivisions.jsx",
        "backend/lib/scope.ts",
        "backend/lib/errorHandler.ts",
        "backend/app/api/home/dashboard/**",
        "backend/app/api/standings/**",
        "backend/app/api/teams/**",
        "backend/app/api/leaderboard/**",
        "backend/app/api/legends/**",
        "backend/app/api/predictions/leaderboard/**",
        "backend/app/api/admin/matches/route.ts",
        "backend/app/api/admin/teams/**",
        "backend/app/api/admin/stats/**",
        "backend/app/api/captain/team-branding/**",
        "backend/app/api/polls/**",
        "backend/supabase/migrations/*flairs*",
        "backend/supabase/migrations/*legacy*",
        "backend/app/api/schedule/**",
        "backend/app/api/predictions/history/**",
        "backend/app/api/players/**",
        "backend/app/api/admin/predictions/grade/**",
        "backend/app/api/admin/predictions/regrade-all/**",
        "backend/supabase/migrations/*fantasy*"
      ],
      "testPaths": [
        "backend/tests/divisions/**",
        "frontend/src/components/admin/__tests__/ManageDivisions.local.test.jsx"
      ]
    },
    "rosters": {
      "description": "Player identity and season rosters: one reusable FUT card per person, roster places per season, season-specific statistics from one source, dictator roster management and captain roster edits, against the local Auth and Data API (allowed and denied cases)",
      "owner": "backend",
      "requiresLocalDb": true,
      "paths": [
        "backend/tests/rosters/**",
        "backend/supabase/migrations/*roster*",
        "backend/supabase/rehearsal/**",
        "backend/app/api/players/**",
        "backend/app/api/leaderboard/**",
        "backend/app/api/legends/**",
        "backend/app/api/home/dashboard/**",
        "backend/app/api/admin/matches/live/**",
        "backend/lib/roster/**",
        "backend/app/api/admin/freshers/**"
      ],
      "run": [
        {
          "cwd": "backend",
          "cmd": [
            "pnpm",
            "exec",
            "vitest",
            "run",
            "--no-file-parallelism",
            "tests/rosters"
          ]
        }
      ],
      "covers": [
        "backend/supabase/migrations/*roster*",
        "backend/supabase/rehearsal/**",
        "backend/app/api/players/**",
        "backend/app/api/leaderboard/**",
        "backend/app/api/legends/**",
        "backend/app/api/home/dashboard/**",
        "backend/app/api/admin/matches/live/**",
        "backend/lib/roster/**",
        "backend/app/api/admin/freshers/**"
      ],
      "testPaths": [
        "backend/tests/rosters/**"
      ]
    },
    "auth-roles": {
      "description": "Five-role authorization: API checks and RLS (user, captain, scorer, editor, dictator)",
      "owner": "backend",
      "status": "pending",
      "pendingFor": "SL-024/SL-025",
      "paths": [
        "backend/lib/auth/**",
        "backend/supabase/migrations/**",
        "backend/app/api/admin/**",
        "backend/app/api/captain/**"
      ],
      "run": []
    },
    "api-services": {
      "description": "Backend API services and contracts",
      "owner": "backend",
      "status": "pending",
      "pendingFor": "SL-026/SL-030",
      "paths": [
        "backend/app/api/**",
        "backend/index.js",
        "backend/lib/**"
      ],
      "run": []
    },
    "match-operations": {
      "description": "Scorer workspace, match events, cards, lineups, brackets, statistics",
      "owner": "backend",
      "status": "pending",
      "pendingFor": "SL-022/SL-050/SL-053/SL-054",
      "paths": [
        "backend/app/api/matches/**",
        "backend/app/api/admin/matches/**",
        "backend/app/api/standings/**"
      ],
      "run": []
    },
    "fantasy": {
      "description": "Division fantasy and World Cup fantasy scoring and predictions",
      "owner": "backend",
      "status": "pending",
      "pendingFor": "SL-022/SL-043",
      "paths": [
        "backend/app/api/leaderboard/**",
        "backend/app/api/predictions/**",
        "backend/app/api/wc/**",
        "worldcup2026_current_group_standings.json"
      ],
      "run": []
    },
    "frontend-components": {
      "description": "React components, hooks and pages (Vitest)",
      "owner": "frontend",
      "paths": [
        "frontend/src/**",
        "frontend/index.html",
        "frontend/vite.config.js"
      ],
      "run": [
        {
          "cwd": "frontend",
          "cmd": [
            "pnpm",
            "exec",
            "vitest",
            "run",
            "--passWithNoTests"
          ]
        }
      ],
      "covers": [
        "frontend/src/**",
        "frontend/index.html",
        "frontend/vite.config.js"
      ],
      "testPaths": [
        "frontend/src/**/__tests__/**",
        "frontend/src/**/*.test.*"
      ]
    },
    "e2e": {
      "description": "Browser end-to-end flows (Playwright); scheduled/release runs only",
      "owner": "frontend",
      "status": "pending",
      "pendingFor": "SL-100",
      "scheduledOnly": true,
      "paths": [
        "backend/app/**",
        "frontend/**"
      ],
      "run": []
    }
  },
  "allGroupsTriggers": [
    ".npmrc",
    ".nvmrc",
    "backend/eslint.config.mjs",
    "backend/next.config.ts",
    "backend/package.json",
    "backend/pnpm-lock.yaml",
    "backend/postcss.config.mjs",
    "backend/tsconfig.json",
    "backend/vitest.config.ts",
    "frontend/eslint.config.js",
    "frontend/package.json",
    "frontend/pnpm-lock.yaml",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml"
  ]
}
