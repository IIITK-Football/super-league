# Copy to backend/supabase/.env (git-ignored). Read by the Supabase CLI for env(...) values in config.toml.
# Optional: only needed to try Google sign-in locally. Email and password sign-in works without it.
# Create an OAuth client in Google Cloud Console (Web application) with the authorised redirect URI
#   http://127.0.0.1:54321/auth/v1/callback
# Never commit real values.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
