# NOT needed for normal local development: the API runs as the Worker in api/ and reads api/.dev.vars
# (copy api/.dev.vars.example). Tests read the local keys from `pnpm exec supabase status` themselves.
#
# This file is the template for backend/.env.staging.local (git-ignored), used only by maintainers to run the scripted
# staging checks (scripts/staging-checks.mjs, scripts/staging-media-check.mjs). Those scripts refuse any project but
# staging. Server-only values: never prefix with NEXT_PUBLIC_ or VITE_. Placeholders only; never commit real keys.
SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...): low privilege, RLS applies.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): bypasses RLS. Server only. Never put it in the frontend, a VITE_ variable, or Git.
SUPABASE_SECRET_KEY=

# The staging scripts require this to be exactly true before they contact a remote project.
# ALLOW_REMOTE_SUPABASE=false

# Media storage is reached only through the API Worker's R2 bindings (api/wrangler.jsonc); no R2 credentials here.
