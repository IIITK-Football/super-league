# Copy to .env.local (git-ignored). Server-only values: never prefix with NEXT_PUBLIC_ or VITE_.

# Supabase API keys. Locally, `pnpm exec supabase status` (run here) prints the matching values.
# Hosted projects: Project Settings -> API Keys. Placeholders only; never commit real keys.
SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...): low privilege, RLS applies. Builds per-user server clients.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): bypasses RLS. Server only, used only by the routes listed in
# docs/supabase-key-usage.md. Never put it in the frontend, a NEXT_PUBLIC_ or VITE_ variable, or Git.
SUPABASE_SECRET_KEY=

# Development refuses a non-local SUPABASE_URL unless this is explicitly set to true.
# ALLOW_REMOTE_SUPABASE=false

# Scheduled-job and third-party API credentials (leave blank locally unless testing those jobs).
CRON_SECRET=
API_FOOTBALL_KEY=
API_SPORTS_KEY=

# Cloudflare R2 (optional locally; storage redesign and Wrangler emulation come later).
# Leave blank: local work must not use production buckets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_FRESHERS_BUCKET_NAME=
R2_LOGO_BUCKET=
R2_PUBLIC_URL=
R2_LOGO_PUBLIC_URL=
NEXT_PUBLIC_R2_URL=
NEXT_PUBLIC_FRESHERS_R2_URL=
NEXT_PUBLIC_VIDEO_R2_URL=
