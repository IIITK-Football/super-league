# Copy to .env.local. Everything with a VITE_ prefix is bundled into the browser:
# only public values belong here. Never put a service-role key, R2 secret, or password in this file.

# Local Supabase stack (run `pnpm exec supabase status` in backend/ for the anon key).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Backend API base. Leave blank to use same-origin /api.
VITE_API_URL=http://127.0.0.1:3000/api

# Development refuses a non-local Supabase URL unless this is explicitly set to true.
# VITE_ALLOW_REMOTE_SUPABASE=false
