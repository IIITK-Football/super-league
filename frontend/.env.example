# Copy to .env.local. Everything with a VITE_ prefix is bundled into the browser:
# only public values belong here. Never put a Supabase secret key, R2 secret, or password in this file.
# (Server-side Pages Function variables are in .dev.vars.example; backend values are in backend/.env.example.)

# Supabase project URL and PUBLISHABLE key (sb_publishable_..., safe to expose; RLS protects data).
# Locally, `pnpm exec supabase status` (run in backend/) prints the matching values.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile site key (public). This is Cloudflare's published always-pass TEST key; it
# pairs with the local Auth test secret. Leave blank to hide the widget (only works while the Auth
# service has CAPTCHA turned off). Real site keys belong in the host's environment settings.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Backend API base. Leave blank to use same-origin /api.
VITE_API_URL=http://127.0.0.1:3000/api

# Development refuses a non-local Supabase URL unless this is explicitly set to true.
# VITE_ALLOW_REMOTE_SUPABASE=false
