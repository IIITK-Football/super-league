{
  "name": "super-league",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "install:all": "pnpm install --frozen-lockfile",
    "dev:frontend": "pnpm --filter ./frontend dev",
    "dev:backend": "pnpm --filter ./backend dev",
    "build:frontend": "pnpm --filter ./frontend build",
    "build:backend": "pnpm --filter ./backend build",
    "lint": "pnpm -r lint",
    "db:check": "bash scripts/local-db.sh check",
    "db:start": "bash scripts/local-db.sh start",
    "db:stop": "bash scripts/local-db.sh stop",
    "db:reset": "bash scripts/local-db.sh reset",
    "db:test": "bash scripts/local-db.sh test",
    "db:psql": "bash scripts/local-db.sh psql",
    "test": "node scripts/test-groups.mjs affected",
    "test:all": "node scripts/test-groups.mjs all",
    "test:group": "node scripts/test-groups.mjs run",
    "test:groups": "node scripts/test-groups.mjs list",
    "hooks:install": "bash scripts/install-hooks.sh",
    "hooks:uninstall": "bash scripts/install-hooks.sh --remove",
    "db:inventory": "bash scripts/local-db.sh inventory"
  },
  "devDependencies": {
    "supabase": "^2.119.0"
  }
}
