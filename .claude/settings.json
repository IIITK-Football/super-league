{
  "model": "opusplan",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Bash(git commit --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(gh pr merge*)",
      "Bash(pnpm work approve*)",
      "Bash(pnpm work attest*)",
      "Bash(pnpm -s work approve*)",
      "Bash(pnpm -s work attest*)",
      "Bash(pnpm run work approve*)",
      "Bash(pnpm run work attest*)",
      "Bash(node scripts/work/cli.mjs approve*)",
      "Bash(node scripts/work/cli.mjs attest*)",
      "Bash(supabase link*)",
      "Bash(pnpm exec supabase link*)",
      "Bash(supabase * --linked*)",
      "Bash(pnpm exec supabase * --linked*)",
      "Bash(supabase db push*)",
      "Bash(pnpm exec supabase db push*)",
      "Bash(supabase migration repair*)",
      "Bash(pnpm exec supabase migration repair*)",
      "Edit(backlog/approvals/**)",
      "Write(backlog/approvals/**)",
      "Edit(backlog/attestations/**)",
      "Write(backlog/attestations/**)",
      "Edit(backlog/evidence/**)",
      "Write(backlog/evidence/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}\"/scripts/work/claude-guard.mjs pre-tool"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}\"/scripts/work/claude-guard.mjs pre-tool"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}\"/scripts/work/claude-guard.mjs session-start"
          }
        ]
      }
    ]
  }
}
